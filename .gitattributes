# Git stores text as LF; .prettierrc sets endOfLine: "lf". Without this file a
# clone under core.autocrlf=true checks out CRLF, and `npm run format:check`
# then fails on every file in the repository — a local-only failure that says
# nothing about the code and hides real formatting drift behind the noise.
* text=auto eol=lf

# Binary assets: never normalised, never diffed as text.
*.png binary
*.ico binary
*.jpg binary
*.jpeg binary
*.gif binary
*.webp binary
*.woff binary
*.woff2 binary
*.pdf binary

# Windows-only scripts genuinely need CRLF.
*.bat text eol=crlf
*.cmd text eol=crlf
