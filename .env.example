# ─────────────────────────────────────────────────────────────────────────────
# xecret — environment variable reference
#
# THIS FILE DOCUMENTS VARIABLE NAMES ONLY. IT CONTAINS NO VALUES AND NEVER WILL.
#
# Real values live in Phase.dev. There is no .env file on any developer machine:
#
#     phase run -- npm run dev            local development
#     phase run -- npm run db:migrate     migrations
#     phase run -- wrangler deploy        deploy
#
# See docs/adr/0002-root-key-custody.md for why the runtime never fetches
# secrets over the network.
# ─────────────────────────────────────────────────────────────────────────────


# ── Database (ADR 0006) ──────────────────────────────────────────────────────

# ONE database, TWO logins. Both strings point at the same Neon database and
# differ only in the user. Setup walkthrough: docs/operations/database-setup.md

# The application's login. A restricted role with no DDL rights, and no UPDATE
# or DELETE on audit_logs — so a SQL-injection bug or a stolen connection string
# can neither drop a table nor erase the record of having tried.
#
# NOT the `xecret_app_permissions` role from migration 0002 — that one is NOLOGIN and cannot
# be connected to. It is a group role holding the privileges; you create a LOGIN
# role that is a member of it (e.g. `xecret_app_login`) and use that here.
#
# In a deployed Worker this is unused: the Hyperdrive binding supplies the
# connection string. This variable is for local development.
DATABASE_URL=

# The owner login, used by `npm run db:migrate` and by nothing else. It can
# create and drop tables, which is exactly why the application never uses it.
# Use Neon's DIRECT endpoint here, not the pooled one — migrations run DDL.
MIGRATION_DATABASE_URL=


# ── Encryption (ADR 0002) ────────────────────────────────────────────────────

# Root Key Encryption Keys, as a JSON object mapping version to a base64url
# 256-bit key:
#
#     {"1":"<43 base64url characters>"}
#
# A map rather than a single value because rotation needs both keys readable at
# once: rows wrapped under version 1 stay readable until every one has been
# re-wrapped under version 2. Only when the re-wrap completes is version 1
# removed — and only then may its escrow shares be destroyed.
#
# ⚠  LOSING THIS PERMANENTLY DESTROYS EVERY CUSTOMER'S SECRETS. A database
#    backup does not help — ciphertext without the key is noise.
#    Generate it only via the ceremony in docs/security/key-recovery.md:
#    `npm run keygen` prints the exact JSON to paste, plus the escrow shares.
#
# In production this is NOT read from an env var: it is bound to the Worker from
# Cloudflare Secrets Store under the same name. See apps/web/wrangler.jsonc.
XECRET_ROOT_KEYS=

# Which Root KEK version new wrap operations should use. Increment on rotation,
# and only after the new version is present in XECRET_ROOT_KEYS.
XECRET_ROOT_KEY_VERSION=1


# ── Authentication (ADR 0003) ────────────────────────────────────────────────

# The whole Firebase web config, as one JSON object. Copy it verbatim from the
# Firebase console: Project settings → Your apps → SDK setup and configuration.
#
#   {"apiKey":"…","authDomain":"…","projectId":"…","appId":"…"}
#
# One variable rather than four, because these values are a set: they come from
# one project and only make sense together. Splitting them invites a
# half-migration where projectId points at staging and apiKey at production.
#
# Public by design. Every value here is embedded in the client bundle; they
# identify the project, they do not authorise anything.
NEXT_PUBLIC_FIREBASE_CONFIG=

# Server-side verification. Must equal the projectId inside the JSON above.
#
# Kept separate on purpose: this is the value the Worker checks an ID token's
# `aud` claim against, and it must come from server configuration rather than
# from anything a client could influence. Same value, different trust path.
FIREBASE_PROJECT_ID=


# ── Application ──────────────────────────────────────────────────────────────

# Public origin. Used for CLI callback validation, cookie scope, and OAuth
# redirect registration. Must exactly match the deployed domain.
#
# Read twice, at two different times, and both matter. The Worker reads it at
# runtime from the binding declared in apps/web/wrangler.jsonc. `next build`
# reads it from *this* environment, because every documentation page is
# prerendered and its canonical URL, sitemap entry and robots.txt Host line are
# decided before a binding exists. scripts/deploy-web.sh keeps the two in step
# by exporting wrangler.jsonc's value for the environment being deployed; a
# build run by hand has to set it, and refuses to guess when XECRET_ENV names a
# deployment.
XECRET_PUBLIC_URL=http://localhost:3030

# development | staging | production
XECRET_ENV=development


# ── Email (ZeptoMail) ────────────────────────────────────────────────────────
#
# xecret sends exactly one kind of mail: the link that resets a forgotten unlock
# PIN. Everything else in the product works without this, so leaving these blank
# is a supported configuration — the reset flow then reports that email is not
# configured rather than silently failing.
#
# Where each value comes from, in the ZeptoMail console (zoho.com/zeptomail):
#
#   1. Add and verify your sending domain under Mail Agents → Domains. Zoho
#      refuses a send from an unverified domain rather than rewriting it, so
#      this step is not optional.
#   2. Create a Mail Agent, then open its "Setup" → "API" tab.
#   3. Copy the Send Mail Token. The console shows it as
#      `Zoho-enczapikey wSsVR…` — pasting the whole line is fine, the prefix is
#      stripped on the way in.
#
# This is a credential: it authorises sending mail as your domain. It belongs in
# Phase.dev / Secrets Store, never in a committed file.
ZEPTOMAIL_TOKEN=

# Must be an address on the verified domain.
ZEPTOMAIL_FROM_ADDRESS=noreply@yourdomain.com

# The display name beside that address. Defaults to "xecret" when blank.
ZEPTOMAIL_FROM_NAME=xecret

# The regional API host. A token is only valid in the data centre that issued
# it, so an account created outside the default region MUST set this — otherwise
# every send fails authentication with a 401 that says nothing about why.
#
#   default / US   https://api.zeptomail.com/v1.1/email   (leave blank)
#   Europe         https://api.zeptomail.eu/v1.1/email
#   India          https://api.zeptomail.in/v1.1/email
#   Australia      https://api.zeptomail.com.au/v1.1/email
#   Canada         https://api.zeptomail.ca/v1.1/email
#   Japan          https://api.zeptomail.jp/v1.1/email
#   Saudi Arabia   https://api.zeptomail.sa/v1.1/email
ZEPTOMAIL_API_URL=


# ── Cloudflare (deploy time only) ────────────────────────────────────────────

CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=
