{
  "description": "Cross-implementation fixtures for the P19 secret-policy value rules. Read by packages/core/src/policy/fixtures/fixtures.test.ts and by the Go CLI. The value rules run in every client that holds a plaintext. A value case's optional valueType is the type the secret will hold; 'template' reads only the literal text, and skips the entropy rule unless it parses to no reference at all (review round 2, F3). namePatterns is different: the name rule itself stays the server's alone (TypeScript only); these fixtures are read by cli/internal/policy's own LongestRepeatRun/NamePatternIsSafe port purely for cross-language parity (review round 2, F2) — Go's RE2 is immune to the backtracking this guards against, but a pattern the server refuses as unsafe should be one this package's own tests agree is unsafe too.",
  "namePatterns": [
    {
      "name": "a group with no quantifier of its own, whose content repeats, three times in a row",
      "pattern": "(?:[A-Z_]*)(?:[A-Z_]*)(?:[A-Z_]*)",
      "safe": false
    },
    {
      "name": "a zero-width escape between three repeated parts",
      "pattern": "[A-Z_]*\\B[A-Z_]*\\B[A-Z_]*",
      "safe": false
    },
    {
      "name": "an empty group between three repeated parts",
      "pattern": "A*()A*()A*",
      "safe": false
    },
    {
      "name": "an empty lookaround between three repeated parts",
      "pattern": "A*(?=)A*(?=)A*",
      "safe": false
    },
    {
      "name": "two of the same bypass is still only two",
      "pattern": "A*()A*",
      "safe": true
    },
    {
      "name": "an ordinary pattern with no repeated group",
      "pattern": "[A-Z][A-Z0-9_]*",
      "safe": true
    }
  ],
  "entropy": [
    { "value": "", "bits": 0 },
    { "value": "aaaaaaaaaaaaaaaa", "bits": 0 },
    { "value": "ab", "bits": 2 },
    { "value": "password1", "bits": 27 },
    { "value": "q8Z2xL0vR9sT4bW7nY1cK6mP3dF5gH0j", "bits": 158 },
    { "value": "🔑🔑", "bits": 0 },
    { "value": "café", "bits": 8 }
  ],
