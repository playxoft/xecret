{
  "name": "@xecret/web",
  "version": "0.1.0",
  "private": true,
  "license": "AGPL-3.0-only",
  "scripts": {
    "dev": "next dev -p 3030",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "// typecheck": "next typegen emits LayoutProps/PageProps and next-env.d.ts; tsc needs them and CI must not run a full build just to typecheck",
    "typecheck": "next typegen && tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "preview": "opennextjs-cloudflare build && opennextjs-cloudflare preview",
    "// deploy": "Delegates to the repository script rather than calling opennextjs-cloudflare directly. `lib/site.ts` reads the deployment's origin from the build environment, and only the script puts it there — reading it from wrangler.toml for the environment being deployed. A bare `opennextjs-cloudflare build && deploy` here still built and still succeeded, and shipped http://localhost:3030 as the canonical of every prerendered page.",
    "deploy": "sh ../../scripts/deploy-web.sh",
    "cf-typegen": "wrangler types --env-interface CloudflareEnv src/cloudflare-env.d.ts"
  },
  "dependencies": {
    "@radix-ui/react-checkbox": "^1.3.11",
    "@radix-ui/react-dialog": "^1.1.23",
    "@radix-ui/react-dropdown-menu": "^2.1.24",
    "@radix-ui/react-label": "^2.1.15",
    "@radix-ui/react-select": "^2.3.7",
    "@radix-ui/react-separator": "^1.1.15",
    "@radix-ui/react-slot": "^1.3.3",
    "@radix-ui/react-switch": "^1.3.7",
    "@radix-ui/react-tabs": "^1.1.21",
    "@radix-ui/react-tooltip": "^1.2.16",
    "@xecret/core": "*",
    "@xecret/db": "*",
    "client-only": "0.0.1",
    "clsx": "^2.1.1",
    "firebase": "^12.17.1",
    "firebase-auth-cloudflare-workers": "^2.0.6",
    "marked": "^16.4.2",
    "next": "16.3.0",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "tailwind-merge": "^3.6.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@opennextjs/cloudflare": "^1.20.2",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^22",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.3.0",
    "tailwindcss": "^4",
    "typescript": "^5",
    "vitest": "^4.1.11",
    "wrangler": "^4.124.0"
  }
}
