{
  "name": "xecret",
  "version": "0.1.0",
  "private": true,
  "license": "AGPL-3.0-only",
  "description": "Open-source, developer-first secret management. Powered by Playxoft.",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "engines": {
    "node": ">=20.9.0"
  },
  "scripts": {
    "dev": "npm run dev --workspace @xecret/web",
    "build": "npm run build --workspace @xecret/web",
    "preview": "npm run preview --workspace @xecret/web",
    "deploy": "npm run deploy --workspace @xecret/web",
    "// lint": "Two configs: eslint.config.mjs covers packages/ and scripts/; apps/web has its own because it needs the Next.js and React rules",
    "lint": "eslint packages scripts && npm run lint --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "test": "npm run test --workspaces --if-present",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "db:generate": "npm run db:generate --workspace @xecret/db",
    "db:migrate": "npm run db:migrate --workspace @xecret/db",
    "db:studio": "npm run db:studio --workspace @xecret/db",
    "cli:build": "cd cli && go build -o dist/xecret ./cmd/xecret",
    "cli:test": "cd cli && go test ./...",
    "cli:lint": "cd cli && go vet ./...",
    "check:bundle": "node scripts/check-bundle-size.mjs",
    "verify": "npm run format:check && npm run lint && npm run typecheck && npm run test",
    "keygen": "tsx scripts/keygen.ts",
    "rotate:root-key": "tsx scripts/rotate-root-key.ts",
    "check:db-role": "tsx scripts/check-db-role.ts",
    "// phase": "Phase.dev wrappers, grouped so an editor lists them together. The plain scripts above stay vendor-neutral: CI and self-hosters on Doppler or a .env file run those directly.",
    "phase:dev": "phase run -- npm run dev",
    "phase:build": "phase run -- npm run build",
    "phase:deploy": "phase run -- npm run deploy",
    "phase:migrate": "phase run -- npm run db:migrate",
    "phase:studio": "phase run -- npm run db:studio",
    "phase:check-db": "phase run -- npm run check:db-role",
    "check:env": "tsx scripts/check-env.ts",
    "phase:check-env": "phase run -- npm run check:env",
    "smoke": "tsx scripts/smoke-test.ts",
    "phase:smoke": "phase run -- npm run smoke",
    "kill:4050": "kill -9 $(lsof -t -i:3000)"
  },
  "devDependencies": {
    "@eslint/js": "^9",
    "eslint": "^10",
    "prettier": "^3.4.2",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "tsx": "^4.23.12",
    "typescript-eslint": "^8.67.0"
  }
}
